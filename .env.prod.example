# =====================================================================
#  Production — copier ce fichier en `.env` sur le VPS puis remplir.
#  Générer les secrets avec :  openssl rand -hex 32
#  Ce fichier `.env` ne doit JAMAIS être commité.
# =====================================================================

# Domaine racine (les sous-domaines api., resa. et staff. doivent pointer vers le VPS)
DOMAIN=mondomaine.fr

# Email utilisé par Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=tombenat99@hotmail.fr

# Mot de passe PostgreSQL
DB_PASSWORD=

# Secret Symfony (openssl rand -hex 32)
APP_SECRET=

# Passphrase des clés JWT (openssl rand -hex 32) — NE PAS réutiliser celle du .env de dev
JWT_PASSPHRASE=

# Origines autorisées (CORS). Attention : `$$` = un seul `$` (échappement docker compose).
# Adapter le domaine (échapper les points avec \.)
CORS_ALLOW_ORIGIN=^https://(resa|staff)\.mondomaine\.fr$$
